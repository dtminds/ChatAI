# Copy this file to apps/workflow-worker/.env.local for local development.
# Keep DATABASE_URL, WORKFLOW_PULSAR_TOKEN and JAVA_INTERNAL_API_TOKEN in local or deployment secrets only.
DATABASE_URL=
WORKFLOW_ENTITLEMENT_API_URL=
# Unset or allow skips Java entitlement checks. Set enforce after the Java API is available.
# WORKFLOW_ENTITLEMENT_MODE=allow
JAVA_INTERNAL_API_BASE_URL=
JAVA_INTERNAL_API_TOKEN=
WORKFLOW_PULSAR_SERVICE_URL=
WORKFLOW_PULSAR_TOKEN=
WORKFLOW_PULSAR_CLUSTER_ID=
WORKFLOW_PULSAR_NAMESPACE=chatai-workflow
# Entry/Task Topic, Subscription and DLQ are all required and are never derived from an environment name.
WORKFLOW_ENTRY_TOPIC=topic-workflow-entry-dev
WORKFLOW_TASK_TOPIC=topic-workflow-task-dev
WORKFLOW_ENTRY_SUBSCRIPTION=consumer-chatai-worker-entry-dev
WORKFLOW_TASK_SUBSCRIPTION=consumer-chatai-worker-task-dev
WORKFLOW_ENTRY_DLQ_TOPIC=topic-workflow-entry-dev-dlq
WORKFLOW_TASK_DLQ_TOPIC=topic-workflow-task-dev-dlq
WORKFLOW_WORKER_ROLES=entry-consumer,task-consumer,inference,scheduler,outbox,reconciler
WORKFLOW_HEALTH_PORT=3002
WORKFLOW_MAX_REDELIVER_COUNT=5
WORKFLOW_ENTRY_CONCURRENCY=10
WORKFLOW_TASK_CONCURRENCY=10
WORKFLOW_BATCH_SIZE=100
WORKFLOW_LEASE_DURATION_MS=60000
WORKFLOW_CAPABILITY_TIMEOUT_MS=15000
WORKFLOW_CAPABILITY_RETRY_DELAY_MS=5000
WORKFLOW_CAPABILITY_MAX_RETRY_DELAY_MS=300000
WORKFLOW_INFERENCE_CONCURRENCY=10
WORKFLOW_INFERENCE_INTERVAL_MS=1000
WORKFLOW_INFERENCE_LEASE_DURATION_MS=60000
WORKFLOW_INFERENCE_HEARTBEAT_INTERVAL_MS=15000
WORKFLOW_INFERENCE_RETRY_DELAY_MS=5000
WORKFLOW_INFERENCE_MAX_RETRY_DELAY_MS=300000
WORKFLOW_INFERENCE_MAX_ATTEMPTS=5
WORKFLOW_INFERENCE_TOTAL_TIMEOUT_MS=600000
VOLCENGINE_ARK_API_KEY=
PLAYABLE_MEDIA_HOST=b5.bokr.com.cn
WORKFLOW_MAX_TASK_ATTEMPTS=5
WORKFLOW_MAX_OUTBOX_ATTEMPTS=100
WORKFLOW_MAX_OUTBOX_RETRY_DELAY_MS=300000
WORKFLOW_OUTBOX_PUBLISH_CONCURRENCY=8
WORKFLOW_DISPATCH_TIMEOUT_MS=300000
WORKFLOW_INBOX_CLEANUP_BATCH_SIZE=1000
WORKFLOW_HISTORY_CLEANUP_BATCH_SIZE=1000
WORKFLOW_HISTORY_CLEANUP_INTERVAL_MS=3600000
WORKFLOW_SCHEDULER_INTERVAL_MS=1000
WORKFLOW_OUTBOX_INTERVAL_MS=1000
WORKFLOW_OUTBOX_RETRY_DELAY_MS=5000
WORKFLOW_RECONCILE_INTERVAL_MS=30000
WORKFLOW_READINESS_INTERVAL_MS=30000
