JWT_DEV_SECRET=dev-only-change-me
# Local/e2e only: fixed account used by the isolated browser for UI inspection.
E2E_LOGIN_ENABLED=false
E2E_LOGIN_USER_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ALTCHA_HMAC_SECRET=dev-only-change-me
ALTCHA_COST=4
ALTCHA_MEMORY_COST=8
ALTCHA_PARALLELISM=1
ALTCHA_COUNTER_MIN=5000
ALTCHA_COUNTER_MAX=10000
# Required when NODE_ENV is production or test. Local development may leave it empty.
DATABASE_URL=
# Configure the local value in apps/backend/.env.local; do not commit real hosts.
JAVA_INTERNAL_API_BASE_URL=
JAVA_INTERNAL_API_TOKEN=
# Optional override. Workflow active Run capacity defaults to 10000 per tenant.
WORKFLOW_ACTIVE_RUN_LIMIT=10000
JAVA_INTERNAL_API_TIMEOUT_MS=8000
JAVA_INTERNAL_API_AGENT_TEST_TIMEOUT_MS=60000
JAVA_INTERNAL_API_STREAM_IDLE_TIMEOUT_MS=60000
PLAYABLE_MEDIA_HOST=b5.bokr.com.cn
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=chatai:
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=500
INSIGHTS_WORKER_UID_ALLOWLIST=
INSIGHTS_WORKER_OBSERVER_SUBJECTS=
# LLM node test Attempts are disabled by default. mock is allowed only outside production.
