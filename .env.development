VITE_API_BASE_URL=/api
VITE_WORKFLOW_FIXTURES_ENABLED=true
VITE_DEV_SERVER_HOST=chat-dev.bokr.com.cn
VITE_DEV_SERVER_PORT=8086
# Local Embed URL: http://chat-embed.localhost:8086/embed/workflows
VITE_DEV_API_PROXY_TARGET=http://chat-dev.bokr.com.cn:3001
VITE_DEV_API_PROXY_CHANGE_ORIGIN=false
