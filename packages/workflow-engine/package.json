{
  "name": "@chatai/workflow-engine",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-contract-registry": {
      "types": "./dist/node-contract-registry.d.ts",
      "default": "./dist/node-contract-registry.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @chatai/contracts build && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @chatai/contracts build && tsc --noEmit"
  },
  "dependencies": {
    "@chatai/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
