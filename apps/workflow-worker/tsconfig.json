{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@chatai/contracts": ["../../packages/contracts/src/index.ts"],
      "@chatai/database": ["../../packages/database/src/index.ts"],
      "@chatai/llm": ["../../packages/llm/src/index.ts"],
      "@chatai/tickets": ["../../packages/tickets/src/index.ts"],
      "@chatai/workflow-engine": ["../../packages/workflow-engine/src/index.ts"],
      "@chatai/workflow-runtime": ["../../packages/workflow-runtime/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/database" },
    { "path": "../../packages/llm" },
    { "path": "../../packages/tickets" },
    { "path": "../../packages/workflow-engine" },
    { "path": "../../packages/workflow-runtime" }
  ]
}
