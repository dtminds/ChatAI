VITE_API_BASE_URL=/api
# Required at build time. Comma-separated hostnames without schemes or paths.
VITE_CHAT_EMBED_HOSTNAMES=
VITE_WORKFLOW_FIXTURES_ENABLED=false

NODE_ENV=production
PORT=3001
# Required at runtime. Keep aligned with VITE_CHAT_EMBED_HOSTNAMES.
CHAT_EMBED_HOSTNAMES=
JWT_AUDIENCE=chatai-web
JAVA_INTERNAL_API_BASE_URL=
AUTH_COOKIE_SECURE=true
JWT_ISSUER=chatai-server
LOG_LEVEL=info
REDIS_ENABLED=false
DATABASE_URL=
