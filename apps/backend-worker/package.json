{
  "name": "@chatai/backend-worker",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @chatai/database build && pnpm --filter @chatai/tickets build && pnpm --filter @chatai/insights build && pnpm --filter @chatai/user-memory build && tsc -p tsconfig.json",
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env.local --enable-source-maps src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:production-imports": "node scripts/verify-production-import-graph.mjs"
  },
  "dependencies": {
    "@chatai/database": "workspace:*",
    "@chatai/insights": "workspace:*",
    "@chatai/user-memory": "workspace:*",
    "pino": "^9.9.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
