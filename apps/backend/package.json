{
  "name": "@chatai/backend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @chatai/contracts build && pnpm --filter @chatai/database build && pnpm --filter @chatai/tickets build && pnpm --filter @chatai/insights build && pnpm --filter @chatai/user-memory build && pnpm --filter @chatai/workflow-engine build && pnpm --filter @chatai/workflow-runtime build && tsc -p tsconfig.json",
    "dev": "pnpm build && NODE_ENV=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chatai/contracts": "workspace:*",
    "@chatai/database": "workspace:*",
    "@chatai/insights": "workspace:*",
    "@chatai/tickets": "workspace:*",
    "@chatai/user-memory": "workspace:*",
    "@chatai/workflow-engine": "workspace:*",
    "@chatai/workflow-runtime": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.0.0",
    "@sinclair/typebox": "^0.34.41",
    "altcha-lib": "^2.0.3",
    "argon2": "^0.45.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
